<script>
(function () {
  var Afya = {
    lang: 'fr',
    dark: false,
    tab: 'medecin',
    init: function () {
      this.root = document.getElementById('afya-root');
      if (!this.root) return;
      this.searchInput = this.root.querySelector('#af-search');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Tag content cards with a heading for hover lift
      this.root.querySelectorAll('[data-reveal]').forEach(function (el) {
        if (el.querySelector('h3')) el.setAttribute('data-card', '');
      });

      this.renderChips();
      this.wireSearch();

      // Scroll-reveal
      if (!reduce && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.style.opacity = '1';
              e.target.style.transform = 'translateY(0)';
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        this.root.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
      } else {
        this.root.querySelectorAll('[data-reveal]').forEach(function (el) {
          el.style.opacity = '1'; el.style.transform = 'none';
        });
      }

      // Count-up animation on stats
      var that = this;
      var counters = this.root.querySelectorAll('[data-count]');
      if (!reduce && 'IntersectionObserver' in window) {
        counters.forEach(function (el) { el.textContent = '0'; });
        var sio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { that.countUp(e.target); sio.unobserve(e.target); }
          });
        }, { threshold: 0.5 });
        counters.forEach(function (el) { sio.observe(el); });
      }
    },
    fmt: function (n) { return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '\u202F'); },
    countUp: function (el) {
      var target = parseInt(el.getAttribute('data-count'), 10);
      var dur = 1400, start = performance.now();
      var ease = function (t) { return 1 - Math.pow(1 - t, 3); };
      var that = this;
      var tick = function (now) {
        var t = Math.min(1, (now - start) / dur);
        el.textContent = that.fmt(Math.round(ease(t) * target));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    },
    applyPlaceholder: function () {
      if (!this.searchInput) return;
      var ph = {
        fr: { medecin: 'Spécialité, nom du médecin, ville…', pharmacie: 'Nom de la pharmacie, ville…', medicament: 'Nom du médicament, DCI…' },
        ar: { medecin: 'التخصص، اسم الطبيب، المدينة…', pharmacie: 'اسم الصيدلية، المدينة…', medicament: 'اسم الدواء، DCI…' }
      };
      this.searchInput.placeholder = ph[this.lang][this.tab];
    },
    renderChips: function () {
      var wrap = this.root && this.root.querySelector('#af-chips');
      if (!wrap) return;
      var data = {
        fr: {
          medecin: ['Cardiologue', 'Dentiste', 'Pédiatre', 'Généraliste'],
          pharmacie: ['De garde', 'Ouverte maintenant', 'Alger Centre', 'Oran'],
          medicament: ['Doliprane', 'Amoxicilline', 'Insuline', 'Ventoline']
        },
        ar: {
          medecin: ['طبيب قلب', 'طبيب أسنان', 'طبيب أطفال', 'طبيب عام'],
          pharmacie: ['حراسة', 'مفتوحة الآن', 'الجزائر الوسطى', 'وهران'],
          medicament: ['دوليبران', 'أموكسيسيلين', 'إنسولين', 'فنتولين']
        }
      };
      var label = this.lang === 'ar' ? 'بحث شائع:' : 'Fréquent\u00A0:';
      var chips = data[this.lang][this.tab];
      var that = this;
      wrap.innerHTML = '';
      var lbl = document.createElement('span');
      lbl.textContent = label;
      lbl.style.cssText = 'font-size:12.5px;color:var(--af-muted);font-weight:600;align-self:center;';
      wrap.appendChild(lbl);
      chips.forEach(function (txt) {
        var c = document.createElement('button');
        c.type = 'button';
        c.setAttribute('data-chip', '');
        c.textContent = txt;
        c.style.cssText = 'font-size:12.5px;font-weight:600;color:var(--af-primary-deep);background:var(--af-surface-2);border:1px solid var(--af-border);padding:6px 12px;border-radius:999px;cursor:pointer;';
        c.addEventListener('click', function () {
          if (that.searchInput) { that.searchInput.value = txt; that.searchInput.focus(); }
        });
        wrap.appendChild(c);
      });
    },
    setTab: function (btn) {
      var tab = btn.getAttribute('data-tab');
      this.tab = tab;
      this.root.querySelectorAll('[data-tab]').forEach(function (b) {
        var on = b.getAttribute('data-tab') === tab;
        b.style.background = on ? 'var(--af-primary)' : 'transparent';
        b.style.color = on ? '#fff' : 'var(--af-muted)';
        b.style.boxShadow = on ? '0 6px 16px var(--af-shadow)' : 'none';
      });
      this.applyPlaceholder();
      this.renderChips();
    },
    wireSearch: function () {
      var that = this;
      var btn = this.root.querySelector('button[data-btn][data-ar="بحث"]');
      var input = this.searchInput;
      if (!input || !btn) return;
      var go = function () {
        var routeByTab = { medecin: '/medecins', pharmacie: '/pharmacies', medicament: '/medicaments' };
        var route = routeByTab[that.tab] || '/medecins';
        var q = (input.value || '').trim();
        window.location.href = route + (q ? ('?q=' + encodeURIComponent(q)) : '');
      };
      btn.addEventListener('click', function (e) { e.preventDefault(); go(); });
      input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); go(); } });
    },
    toggleLang: function () {
      this.lang = this.lang === 'fr' ? 'ar' : 'fr';
      var ar = this.lang === 'ar';
      this.root.querySelectorAll('[data-ar]').forEach(function (el) {
        if (ar) { if (el._fr == null) el._fr = el.textContent; el.textContent = el.getAttribute('data-ar'); }
        else if (el._fr != null) el.textContent = el._fr;
      });
      this.root.style.direction = ar ? 'rtl' : 'ltr';
      this.root.style.setProperty('--af-font', ar ? "'Cairo','Poppins',system-ui,sans-serif" : "'Poppins',system-ui,-apple-system,sans-serif");
      var lb = this.root.querySelector('#af-langlabel');
      if (lb) lb.textContent = ar ? 'FR' : 'AR';
      this.applyPlaceholder();
      this.renderChips();
    },
    toggleDark: function () {
      this.dark = !this.dark;
      var s = this.root.style;
      if (this.dark) {
        s.setProperty('--af-bg', '#0A1413'); s.setProperty('--af-surface', '#0F211E'); s.setProperty('--af-surface-2', '#16332E');
        s.setProperty('--af-text', '#EAF4F2'); s.setProperty('--af-muted', '#9FB8B4'); s.setProperty('--af-border', 'rgba(255,255,255,.10)');
        s.setProperty('--af-primary', '#21C7B2'); s.setProperty('--af-primary-deep', '#072B27'); s.setProperty('--af-shadow', 'rgba(0,0,0,.45)');
        s.setProperty('--af-header', 'rgba(10,20,19,.8)');
      } else {
        s.setProperty('--af-bg', '#F1F8F6'); s.setProperty('--af-surface', '#FFFFFF'); s.setProperty('--af-surface-2', '#E8F3F0');
        s.setProperty('--af-text', '#0E2725'); s.setProperty('--af-muted', '#5C7472'); s.setProperty('--af-border', 'rgba(14,39,37,.09)');
        s.setProperty('--af-primary', '#0E9C8A'); s.setProperty('--af-primary-deep', '#0A6F66'); s.setProperty('--af-shadow', 'rgba(13,80,72,.13)');
        s.setProperty('--af-header', 'rgba(255,255,255,.82)');
      }
      var di = this.root.querySelector('#af-darkicon');
      if (di) di.textContent = this.dark ? '☀️' : '🌙';
    }
  };
  window.afya = Afya;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { Afya.init(); });
  else Afya.init();
})();
</script>
</body>
</html>
