<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Afya · Votre santé, simplifiée</title>
  <meta name="description" content="Afya — plateforme santé algérienne : RDV médicaux, médicaments, pharmacies de garde — 58 wilayas couvertes.">
  <meta name="theme-color" content="#0E9C8A">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" href="/icons/afya-192.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<style>
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  a{color:inherit;text-decoration:none}
  button{font-family:inherit;cursor:pointer;border:none}
  @keyframes af-beat{0%,100%{transform:scale(1)}14%{transform:scale(1.18)}28%{transform:scale(1)}42%{transform:scale(1.12)}70%{transform:scale(1)}}
  @keyframes af-floatA{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
  @keyframes af-floatB{0%,100%{transform:translateY(0)}50%{transform:translateY(12px)}}
  @keyframes af-pulse{0%{box-shadow:0 0 0 0 rgba(33,199,178,.5)}70%{box-shadow:0 0 0 16px rgba(33,199,178,0)}100%{box-shadow:0 0 0 0 rgba(33,199,178,0)}}
  @media (prefers-reduced-motion: reduce){
    *{animation:none!important;transition:none!important}
    [data-reveal]{opacity:1!important;transform:none!important}
  }
  /* ---- interactions ---- */
  [data-card]{transition:transform .38s cubic-bezier(.2,.7,.3,1),box-shadow .38s ease,opacity .7s ease,border-color .3s ease!important}
  [data-card]:hover{transform:translateY(-6px)!important;box-shadow:0 24px 52px var(--af-shadow)!important;border-color:rgba(14,156,138,.4)!important}
  [data-btn]{transition:transform .2s ease,box-shadow .2s ease,filter .2s ease!important}
  [data-btn]:hover{transform:translateY(-2px)!important;filter:brightness(1.06)}
  [data-btn]:active{transform:translateY(0)!important;filter:brightness(.98)}
  [data-af=nav] a{transition:background .2s,color .2s}
  [data-af=nav] a:hover{background:var(--af-surface-2)!important;color:var(--af-text)!important}
  footer a{transition:color .2s,opacity .2s}
  footer a:hover{color:#fff!important}
  [data-chip]{transition:background .2s,border-color .2s,transform .15s}
  [data-chip]:hover{background:var(--af-primary)!important;color:#fff!important;border-color:var(--af-primary)!important;transform:translateY(-1px)}
  :focus-visible{outline:2.5px solid var(--af-primary);outline-offset:2px;border-radius:6px}
  /* ---- responsive ---- */
  @media (max-width:980px){
    [data-af=hero]{grid-template-columns:1fr!important;gap:36px!important;padding:72px 22px 80px!important}
    [data-af=hero-visual]{display:none!important}
    [data-af=steps]{grid-template-columns:1fr!important}
    [data-af=features]{grid-template-columns:1fr!important}
    [data-af=garde]{grid-template-columns:1fr!important}
    [data-af=garde] > div{padding:40px 30px!important}
    [data-af=garde-art]{min-height:300px!important}
    [data-af=pros]{grid-template-columns:1fr!important;gap:40px!important;padding:64px 22px!important}
    [data-af=nav]{display:none!important}
  }
  @media (max-width:640px){
    [data-af=stats]{grid-template-columns:repeat(2,1fr)!important;gap:34px 16px!important;padding:44px 22px!important}
    [data-af=footer]{grid-template-columns:1fr 1fr!important;gap:32px 24px!important}
    [data-hide-sm]{display:none!important}
    [data-af=header]{padding:0 16px!important;gap:14px!important}
    [data-af=hero] h1{font-size:38px!important}
    [data-af=garde] > div:first-child{padding:36px 24px!important}
  }
</style>

<div id="afya-root" style="--af-bg:#F1F8F6;--af-surface:#FFFFFF;--af-surface-2:#E8F3F0;--af-text:#0E2725;--af-muted:#5C7472;--af-border:rgba(14,39,37,.09);--af-primary:#0E9C8A;--af-primary-deep:#0A6F66;--af-accent:#F5683B;--af-shadow:rgba(13,80,72,.13);--af-header:rgba(255,255,255,.82);--af-font:'Poppins',system-ui,-apple-system,sans-serif;background:var(--af-bg);color:var(--af-text);font-family:var(--af-font);min-height:100vh;transition:background .4s ease,color .4s ease;overflow-x:hidden;">

  <!-- ============ HEADER ============ -->
  <header style="position:sticky;top:0;z-index:50;background:var(--af-header);backdrop-filter:saturate(180%) blur(16px);-webkit-backdrop-filter:saturate(180%) blur(16px);border-bottom:1px solid var(--af-border);">
    <div data-af="header" style="max-width:1200px;margin:0 auto;padding:0 24px;height:72px;display:flex;align-items:center;gap:32px;">
      <a href="/" style="display:flex;align-items:center;gap:11px;font-weight:800;font-size:22px;letter-spacing:-.02em;">
        <span style="width:38px;height:38px;border-radius:12px;background:linear-gradient(140deg,#0E9C8A,#16B79E);color:#fff;display:flex;align-items:center;justify-content:center;font-size:21px;box-shadow:0 6px 16px rgba(14,156,138,.4);animation:af-beat 2.6s ease-in-out infinite;">✚</span>
        <span>Afya<span style="color:var(--af-primary);"> ·</span> <span style="font-family:'Cairo',sans-serif;font-weight:700;color:var(--af-primary);">عافية</span></span>
      </a>
      <nav data-af="nav" style="display:flex;align-items:center;gap:6px;margin-inline-start:8px;font-size:15px;font-weight:500;">
        <a href="/medecins" style="padding:9px 13px;border-radius:9px;color:var(--af-muted);" data-ar="الأطباء">Médecins</a>
        <a href="/pharmacies" style="padding:9px 13px;border-radius:9px;color:var(--af-muted);" data-ar="الصيدليات">Pharmacies</a>
        <a href="/medicaments" style="padding:9px 13px;border-radius:9px;color:var(--af-muted);" data-ar="الأدوية">Médicaments</a>
        <a href="/carte" style="padding:9px 13px;border-radius:9px;color:var(--af-muted);" data-ar="الخريطة">Carte</a>
        <a href="/tarifs" style="padding:9px 13px;border-radius:9px;color:var(--af-muted);" data-ar="الأسعار">Tarifs</a>
      </nav>
      <div style="margin-inline-start:auto;display:flex;align-items:center;gap:10px;">
        <button onclick="window.afya.toggleLang()" title="Langue" style="display:flex;align-items:center;gap:6px;height:40px;padding:0 14px;border-radius:10px;background:var(--af-surface-2);color:var(--af-text);font-weight:700;font-size:14px;">🌐 <span id="af-langlabel">AR</span></button>
        <button onclick="window.afya.toggleDark()" title="Thème" style="width:40px;height:40px;border-radius:10px;background:var(--af-surface-2);font-size:17px;display:flex;align-items:center;justify-content:center;"><span id="af-darkicon">🌙</span></button>
        <a href="/connexion" data-hide-sm="" style="height:40px;display:flex;align-items:center;padding:0 16px;border-radius:10px;border:1.5px solid var(--af-border);color:var(--af-text);font-weight:600;font-size:14px;" data-ar="تسجيل الدخول">Se connecter</a>
        <a href="/inscription" data-btn="" style="height:40px;display:flex;align-items:center;padding:0 18px;border-radius:10px;background:var(--af-primary);color:#fff;font-weight:700;font-size:14px;box-shadow:0 8px 20px var(--af-shadow);" data-ar="إنشاء حساب">S'inscrire</a>
      </div>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section style="position:relative;background:linear-gradient(143deg,#0A6F66 0%,#0E9C8A 46%,#16B79E 100%);color:#fff;overflow:hidden;">
    <div style="position:absolute;top:-160px;inset-inline-end:-120px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 65%);"></div>
    <div style="position:absolute;bottom:-200px;inset-inline-start:-140px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(8,60,55,.5),transparent 62%);"></div>
    <div style="max-width:1200px;margin:0 auto;padding:108px 24px 112px;display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;position:relative;z-index:2;" data-af="hero">

      <div>
        <span style="display:inline-flex;align-items:center;gap:8px;padding:8px 15px;border-radius:999px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(6px);font-size:14px;font-weight:600;">🇩🇿 <span data-ar="متوفر في 58 ولاية">Présent dans les 58 wilayas</span></span>
        <h1 style="font-size:clamp(40px,5vw,62px);font-weight:800;line-height:1.04;letter-spacing:-.025em;margin:20px 0 16px;" data-ar="صحتك، ببساطة.">Votre santé,<br>simplifiée.</h1>
        <p style="font-size:19px;line-height:1.62;color:rgba(255,255,255,.92);max-width:500px;margin:0 0 32px;" data-ar="احجز موعدك، اعثر على أدويتك وحدّد أقرب صيدلية حراسة — في ثوانٍ معدودة.">Prenez rendez-vous, trouvez vos médicaments et localisez la pharmacie de garde la plus proche — en quelques secondes.</p>

        <!-- Search card -->
        <div style="background:var(--af-surface);border-radius:20px;padding:14px;box-shadow:0 28px 64px rgba(5,46,42,.4);color:var(--af-text);max-width:540px;">
          <div style="display:flex;gap:6px;margin-bottom:12px;">
            <button data-tab="medecin" onclick="window.afya.setTab(this)" style="flex:1;padding:10px;border-radius:10px;font-weight:600;font-size:14px;background:var(--af-primary);color:#fff;box-shadow:0 6px 16px var(--af-shadow);transition:all .2s;"><span data-ar="طبيب">🩺 Médecin</span></button>
            <button data-tab="pharmacie" onclick="window.afya.setTab(this)" style="flex:1;padding:10px;border-radius:10px;font-weight:600;font-size:14px;background:transparent;color:var(--af-muted);transition:all .2s;"><span data-ar="صيدلية">💊 Pharmacie</span></button>
            <button data-tab="medicament" onclick="window.afya.setTab(this)" style="flex:1;padding:10px;border-radius:10px;font-weight:600;font-size:14px;background:transparent;color:var(--af-muted);transition:all .2s;"><span data-ar="دواء">🔍 Médicament</span></button>
          </div>
          <div style="display:flex;align-items:center;gap:8px;background:var(--af-surface-2);border-radius:12px;padding:6px;padding-inline-start:16px;">
            <span style="font-size:18px;opacity:.6;">🔎</span>
            <input id="af-search" data-fr-ph="Spécialité, nom du médecin, ville…" data-ar-ph="التخصص، اسم الطبيب، المدينة…" placeholder="Spécialité, nom du médecin, ville…" style="flex:1;border:none;background:transparent;outline:none;font-size:16px;color:var(--af-text);font-family:inherit;min-width:0;">
            <button data-btn="" style="background:var(--af-primary);color:#fff;font-weight:700;font-size:15px;padding:13px 24px;border-radius:10px;white-space:nowrap;" data-ar="بحث">Rechercher</button>
          </div>
          <div id="af-chips" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:12px;padding:2px 4px;"></div>
        </div>

        <div style="display:flex;align-items:center;gap:9px;margin-top:22px;font-size:14px;color:rgba(255,255,255,.88);">
          <span style="font-size:16px;">✅</span><span data-ar="بيانات رسمية حقيقية — 58 ولاية، دون تسجيل للبحث.">Données réelles et officielles — 58 wilayas, sans inscription pour rechercher.</span>
        </div>
      </div>

      <!-- Hero visual -->
      <div data-af="hero-visual" style="position:relative;height:440px;">
        <div style="position:absolute;inset-inline-end:0;top:10px;width:340px;background:var(--af-surface);color:var(--af-text);border-radius:24px;padding:22px;box-shadow:0 30px 70px rgba(5,46,42,.45);">
          <div style="display:flex;align-items:center;gap:13px;">
            <div style="width:54px;height:54px;border-radius:16px;background:linear-gradient(140deg,#0E9C8A,#16B79E);display:flex;align-items:center;justify-content:center;font-size:26px;">🩺</div>
            <div style="flex:1;">
              <div style="font-weight:700;font-size:16px;">Dr. Amine Belkacem</div>
              <div style="font-size:13px;color:var(--af-muted);" data-ar="طبيب قلب · متعاقد مع CNAS">Cardiologue · Conventionné CNAS</div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--af-primary);">★ 4.9</div>
          </div>
          <div style="margin:18px 0 10px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--af-muted);" data-ar="مواعيد اليوم">Créneaux · Aujourd'hui</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <span style="padding:9px 13px;border-radius:9px;background:var(--af-surface-2);font-size:13px;font-weight:600;">09:00</span>
            <span style="padding:9px 13px;border-radius:9px;background:var(--af-primary);color:#fff;font-size:13px;font-weight:700;box-shadow:0 6px 14px var(--af-shadow);">09:30</span>
            <span style="padding:9px 13px;border-radius:9px;background:var(--af-surface-2);font-size:13px;font-weight:600;">10:00</span>
            <span style="padding:9px 13px;border-radius:9px;background:var(--af-surface-2);font-size:13px;font-weight:600;">11:30</span>
          </div>
          <button data-btn="" style="width:100%;margin-top:16px;background:var(--af-primary);color:#fff;font-weight:700;font-size:15px;padding:13px;border-radius:11px;" data-ar="تأكيد الموعد">Confirmer le rendez-vous</button>
        </div>

        <div style="position:absolute;inset-inline-start:0;top:78px;background:var(--af-surface);color:var(--af-text);border-radius:15px;padding:12px 16px;box-shadow:0 18px 44px rgba(5,46,42,.3);font-size:13px;font-weight:600;display:flex;align-items:center;gap:9px;animation:af-floatA 5s ease-in-out infinite;">
          <span style="width:30px;height:30px;border-radius:9px;background:#E6F7F2;display:flex;align-items:center;justify-content:center;">✅</span><span data-ar="تم تأكيد الموعد">RDV confirmé</span>
        </div>
        <div style="position:absolute;inset-inline-start:18px;bottom:8px;background:var(--af-surface);color:var(--af-text);border-radius:15px;padding:12px 16px;box-shadow:0 18px 44px rgba(5,46,42,.3);font-size:13px;font-weight:600;display:flex;align-items:center;gap:9px;animation:af-floatB 6s ease-in-out infinite;">
          <span style="width:30px;height:30px;border-radius:9px;background:#FFF0E9;display:flex;align-items:center;justify-content:center;">🌙</span><span data-ar="صيدلية حراسة · 1.2 كم">Pharmacie de garde · 1,2 km</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section style="background:var(--af-surface);border-bottom:1px solid var(--af-border);">
    <div style="max-width:1100px;margin:0 auto;padding:54px 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;" data-af="stats">
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;">
        <div data-count="<%= stats.pharmacies %>" style="font-size:44px;font-weight:800;color:var(--af-primary);letter-spacing:-.02em;line-height:1;"><%= stats.pharmacies.toLocaleString('fr-FR').replace(/\u00A0/g, '\u202F') %></div>
        <div style="margin-top:8px;font-size:15px;color:var(--af-muted);font-weight:500;" data-ar="صيدلية مرجعية">Pharmacies référencées</div>
      </div>
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease .08s,transform .7s ease .08s;">
        <div data-count="<%= stats.medicaments %>" style="font-size:44px;font-weight:800;color:var(--af-primary);letter-spacing:-.02em;line-height:1;"><%= stats.medicaments.toLocaleString('fr-FR').replace(/\u00A0/g, '\u202F') %></div>
        <div style="margin-top:8px;font-size:15px;color:var(--af-muted);font-weight:500;" data-ar="دواء (تسمية MIPH)">Médicaments · MIPH</div>
      </div>
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease .16s,transform .7s ease .16s;">
        <div data-count="<%= stats.medecins %>" style="font-size:44px;font-weight:800;color:var(--af-primary);letter-spacing:-.02em;line-height:1;"><%= stats.medecins.toLocaleString('fr-FR').replace(/\u00A0/g, '\u202F') %></div>
        <div style="margin-top:8px;font-size:15px;color:var(--af-muted);font-weight:500;" data-ar="طبيب">Médecins</div>
      </div>
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease .24s,transform .7s ease .24s;">
        <div data-count="<%= stats.wilayas %>" style="font-size:44px;font-weight:800;color:var(--af-primary);letter-spacing:-.02em;line-height:1;"><%= stats.wilayas %></div>
        <div style="margin-top:8px;font-size:15px;color:var(--af-muted);font-weight:500;" data-ar="ولاية مغطاة">Wilayas couvertes</div>
      </div>
    </div>
  </section>

  <!-- ============ COMMENT ÇA MARCHE ============ -->
  <section style="max-width:1200px;margin:0 auto;padding:96px 24px 40px;">
    <div style="text-align:center;max-width:640px;margin:0 auto 56px;">
      <div style="font-size:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--af-primary);" data-ar="بكل بساطة">En toute simplicité</div>
      <h2 style="font-size:clamp(30px,3.6vw,42px);font-weight:800;letter-spacing:-.02em;margin:12px 0;" data-ar="كيف تعمل؟">Comment ça marche ?</h2>
      <p style="font-size:17px;color:var(--af-muted);line-height:1.6;margin:0;" data-ar="ثلاث خطوات بين سؤالك الصحي والعناية بك.">Trois étapes entre votre question santé et votre prise en charge.</p>
    </div>
    <div data-af="steps" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;background:var(--af-surface);border:1px solid var(--af-border);border-radius:20px;padding:30px;">
        <div style="width:46px;height:46px;border-radius:13px;background:var(--af-surface-2);color:var(--af-primary);font-weight:800;font-size:19px;display:flex;align-items:center;justify-content:center;">1</div>
        <h3 style="font-size:21px;font-weight:700;margin:18px 0 8px;" data-ar="ابحث">Recherchez</h3>
        <p style="font-size:15px;line-height:1.6;color:var(--af-muted);margin:0;" data-ar="اعثر على طبيب أو صيدلية أو دواء بكتابة بضعة أحرف.">Trouvez un médecin, une pharmacie ou un médicament en tapant quelques lettres.</p>
      </div>
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease .1s,transform .7s ease .1s;background:var(--af-surface);border:1px solid var(--af-border);border-radius:20px;padding:30px;">
        <div style="width:46px;height:46px;border-radius:13px;background:var(--af-surface-2);color:var(--af-primary);font-weight:800;font-size:19px;display:flex;align-items:center;justify-content:center;">2</div>
        <h3 style="font-size:21px;font-weight:700;margin:18px 0 8px;" data-ar="احجز">Réservez</h3>
        <p style="font-size:15px;line-height:1.6;color:var(--af-muted);margin:0;" data-ar="اختر موعداً متاحاً على مدى 14 يوماً، مؤكَّداً في الوقت الفعلي.">Choisissez un créneau libre sur 14 jours, confirmé en temps réel.</p>
      </div>
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease .2s,transform .7s ease .2s;background:var(--af-surface);border:1px solid var(--af-border);border-radius:20px;padding:30px;">
        <div style="width:46px;height:46px;border-radius:13px;background:var(--af-surface-2);color:var(--af-primary);font-weight:800;font-size:19px;display:flex;align-items:center;justify-content:center;">3</div>
        <h3 style="font-size:21px;font-weight:700;margin:18px 0 8px;" data-ar="اعتنِ بصحتك">Soignez-vous</h3>
        <p style="font-size:15px;line-height:1.6;color:var(--af-muted);margin:0;" data-ar="تلقَّ إشعاراتك واعثر على كل مواعيدك في «حسابي».">Recevez vos notifications et retrouvez tous vos RDV dans Mon compte.</p>
      </div>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section style="max-width:1200px;margin:0 auto;padding:64px 24px 40px;">
    <div data-af="features" style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px;">
      <div data-reveal="" style="opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;background:var(--af-surface);border:1px solid var(--af-border);border-radius:22px;padding:32px;display:flex;gap:20px;">
        <div style="flex:none;width:58px;height:58px;border-radius:16px;background:linear-gradient(140deg,#0E9C8A,#16B79E);display:flex;align-items:center;justify-content:center;font-size:27px;">🩺</div>
        <div>
          <h3 style="font-size:20px;font-weight:700;margin:2px 0 8px;" data-ar="مواعيد عبر الإنترنت 24/7">Rendez-vous en ligne 24/7</h3>
