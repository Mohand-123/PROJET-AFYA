<%- include('partials/head') %>

<section class="container section">
  <h1 class="page-title">✉️ <%= t('contact_title') %></h1>
  <p class="lead"><%= t('contact_subtitle') %></p>

  <% if (sent) { %>
    <div class="alert alert-ok"><%= t('contact_sent_ok') %></div>
  <% } %>

  <div class="contact-grid reveal">
    <div class="card contact-form-card">
      <form action="/contact" method="post" class="form">
        <label><%= t('contact_name') %>
          <input type="text" name="nom" required value="<%= user ? (user.prenom + ' ' + user.nom) : '' %>" />
        </label>
        <label><%= t('contact_email') %>
          <input type="email" name="email" required value="<%= user ? user.email : '' %>" />
        </label>
        <label><%= t('contact_subject') %>
          <input type="text" name="sujet" required placeholder="<%= t('contact_subject_ph') %>" />
        </label>
        <label><%= t('contact_message') %>
          <textarea name="message" rows="6" required placeholder="<%= t('contact_message_ph') %>"></textarea>
        </label>
        <button type="submit" class="btn btn-primary btn-block">📨 <%= t('contact_send') %></button>
      </form>
    </div>

    <aside class="card contact-info-card">
      <h2 class="sub"><%= t('contact_info_title') %></h2>
      <ul class="contact-info-list">
        <li>
          <span class="contact-ico">📞</span>
          <div>
            <strong><%= t('contact_phone') %></strong>
            <p><%= t('contact_phone_value') %></p>
          </div>
        </li>
        <li>
          <span class="contact-ico">✉️</span>
          <div>
            <strong><%= t('email') %></strong>
            <p><%= t('contact_email_value') %></p>
          </div>
        </li>
        <li>
          <span class="contact-ico">📍</span>
          <div>
            <strong><%= t('contact_address') %></strong>
            <p><%= t('contact_address_value') %></p>
          </div>
        </li>
        <li>
          <span class="contact-ico">🕒</span>
          <div>
            <strong><%= t('contact_hours') %></strong>
            <p><%= t('contact_hours_value') %></p>
          </div>
        </li>
      </ul>
    </aside>
  </div>

  <% if (topMedecins && topMedecins.length) { %>
    <div class="suggest-section reveal">
      <h2 class="section-title">⭐ <%= t('discover_doctors') %></h2>
      <div class="cards reveal-children">
        <% topMedecins.forEach(s => { %>
          <a class="card doctor-card suggest-card" href="/medecins/<%= s.id %>">
            <div class="doctor-head">
              <div class="avatar <%= s.sexe === 'F' ? 'avatar-f' : 'avatar-m' %>"><%= s.spec_icone %></div>
              <div>
                <h3>Dr <%= s.prenom %> <%= s.nom %></h3>
                <p class="spec"><%= L(s.spec_fr, s.spec_ar) %></p>
              </div>
              <span class="rating">★ <%= s.note.toFixed(1) %></span>
            </div>
            <p class="muted">📍 <%= s.ville %>, <%= s.wilaya %></p>
            <div class="card-tags">
              <span class="tag tag-price"><%= s.tarif %> <%= t('currency') %></span>
            </div>
            <span class="link-more"><%= t('doctor_book') %> →</span>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (topPharmacies && topPharmacies.length) { %>
    <div class="suggest-section reveal">
      <h2 class="section-title">🌙 <%= t('discover_pharmacies_garde') %></h2>
      <div class="cards reveal-children">
        <% topPharmacies.forEach(p => { %>
          <a class="card pharma-card suggest-card" href="/pharmacies/<%= p.id %>">
            <div class="card-top">
              <span class="badge badge-garde">🌙 <%= t('pharmacy_de_garde') %></span>
              <span class="badge badge-open"><%= t('open_now') %></span>
            </div>
            <h3><%= p.nom %></h3>
            <p class="muted">📍 <%= p.ville %>, <%= p.wilaya %></p>
            <% if (p.telephone) { %><p class="muted">📞 <%= p.telephone %></p><% } %>
            <span class="link-more"><%= t('view_pharmacy') %> →</span>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</section>

<%- include('partials/foot') %>
